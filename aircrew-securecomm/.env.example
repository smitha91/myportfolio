# Environment Configuration for AirCrew SecureComm

# Server Configuration
NODE_ENV=development
PORT=3001
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aircrew_securecomm
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=aircrew-securecomm

# Security Configuration
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_key_minimum_32_characters_long
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW=15

# MFA Configuration
MFA_SERVICE_NAME=AirCrew SecureComm
MFA_ISSUER=AirCrew Security Systems

# Email Configuration (for MFA and notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=noreply@aircrew-securecomm.com
FROM_NAME=AirCrew SecureComm

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/aircrew-securecomm.log
AUDIT_LOG_FILE=logs/audit.log

# Security Headers
CSP_REPORT_URI=/api/v1/security/csp-report
HSTS_MAX_AGE=31536000

# Admin Configuration
ADMIN_EMAIL=admin@aircrew-securecomm.com
ADMIN_DEFAULT_PASSWORD=AdminControl000!

# External Services
SECURITY_SCAN_API_KEY=your_security_scan_api_key
THREAT_INTEL_API_KEY=your_threat_intelligence_api_key

# Development/Testing
ENABLE_API_DOCS=true
ENABLE_SECURITY_TESTING=true
MOCK_MFA=false
