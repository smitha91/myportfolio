{
  "name": "aircrew-securecomm",
  "version": "1.0.0",
  "description": "A beginner's cybersecurity learning project simulating role-based secure communication for aviation crew members",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "devStart": "nodemon server.js",
    "test": "jest",
    "security-scan": "npm audit",
    "lint": "eslint .",
    "build": "npm run build:client",
    "build:client": "cd client && npm run build"
  },
  "keywords": [
    "cybersecurity-learning",
    "aviation",
    "beginner-project",
    "security-simulation",
    "rbac",
    "jwt",
    "node.js",
    "express"
  ],
  "author": "Ashley Smith",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.9.2",
    "express-validator": "^7.0.1",
    "winston": "^3.10.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.3",
    "nodemailer": "^6.9.4",
    "express-session": "^1.17.3",
    "connect-session-sequelize": "^7.1.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.46.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-security": "^1.7.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
